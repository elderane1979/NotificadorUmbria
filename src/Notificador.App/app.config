            </setting>
            <setting name="IniciarMinimizado" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="showMensajesVIP" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="showMensajesTalleresDirector" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="showMensajesTalleresRedactor" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="browser" serializeAs="String">
                <value>default</value>
